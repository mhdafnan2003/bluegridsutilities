# --- Server ---
PORT=5000
# development | production
NODE_ENV=development
# Allowed browser origin for CORS (the deployed website URL in production)
CLIENT_URL=http://localhost:5173
# Number of reverse-proxy hops to trust for client IPs (rate limiting). Set to 1 behind one proxy.
# TRUST_PROXY=1

# --- Where messages are delivered ---
RECRUITMENT_EMAIL=recruitment@bluegridutilities.com
ENQUIRIES_EMAIL=enquiries@bluegridutilities.com

# --- SMTP (required in production) ---
# If SMTP_USER / SMTP_PASS are missing in production, the form endpoints return 503 instead of pretending to send.
# In development, missing SMTP settings fall back to an Ethereal test inbox (preview URL is logged).
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Sender address shown on outgoing mail, e.g. "Bluegrid Utilities" <recruitment@bluegridutilities.com>
SMTP_FROM=

# --- Uploads and abuse protection ---
MAX_UPLOAD_MB=10
# Requests per IP per window on POST /api/contact and POST /api/careers/apply
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=10

# --- Database ---
# SQLite file. Default: server/data/bluegrid.db. On a host with ephemeral disk, point this at a persistent volume.
# DB_PATH=/var/data/bluegrid.db

# --- Admin dashboard (/admin) ---
# Long random string used to sign dashboard sessions. REQUIRED in production (dashboard is disabled without it).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Session length in hours
SESSION_HOURS=12
# Dashboard login. Applied every time the server starts: edit these and restart to change the login ID or password.
# ADMIN_ID can be an email address or a username (3+ characters, no spaces). Password: at least 10 characters.
# If you change ADMIN_ID, the old ID stops working. Extra users: npm run admin:create -- <login ID> <password> [name]
ADMIN_ID=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
